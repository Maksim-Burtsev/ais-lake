{
  "$comment": "Day basemap. Every colour is verbatim from docs/design/tokens.json color.day — change tokens.json (and the frames behind it) first, never this file alone. Layer list mirrors night.json exactly.",
  "version": 8,
  "name": "ais-lake day",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#A9B57C" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": { "fill-color": "#E9DCA9", "fill-opacity": 0.6 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#1163A0" }
    },
    {
      "id": "coastline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "line-color": "#0C3A52", "line-width": 0.6, "line-opacity": 0.55 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": { "line-color": "#0A5F84", "line-width": 0.8 }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": { "line-color": "#7E6C44", "line-width": 0.8, "line-dasharray": [3, 2] }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "maxzoom": 8,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 12,
        "text-letter-spacing": 0.12,
        "text-transform": "uppercase"
      },
      "paint": { "text-color": "#6C7B84", "text-halo-color": "#FBF6EA", "text-halo-width": 1.2 }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "minzoom": 5,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": { "text-color": "#1E2A18", "text-halo-color": "#FBF6EA", "text-halo-width": 1.2 }
    }
  ]
}
